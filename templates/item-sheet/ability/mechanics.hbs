<section class="tab{{#if tab.active}} active{{/if}} scrollable" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="tab-container flexcol">
    <div class="bound-box glass-panel stat-box flex-center ">
      <a class="clickable-anchor" data-tooltip="Open Bounded Item" {{disabled (not system.bound)}}>
        <i class="fa-solid fa-suitcase "></i>
      </a>
      <input class="etheria-input" type="text" name="system.bound" value="{{system.bound}}"
        placeholder="No item bound..." disabled>

      <p class="hint">
        The source item providing this ability to your character
      </p>
    </div>

    <section class="cost-section">
      <div class="glass-panel stat-list ability-list">
        <div class="panel-header flexrow">
          <span class="label">Costs</span>
          <div class="controls">
            <a data-action="createCost" class="fa-solid fa-plus clickable-anchor" data-tooltip="Add Cost"></a>
          </div>
        </div>
        <div class="element-items flexcol">

          {{#each costs as |cost|}}
          <div class="stat-row" data-cost-id="{{cost.id}}">
            <div class="flexcol">
              {{formInput ../costFields.value name=(concat cost.name ".value") placeholder="Value"
              value=cost.value.value classes="etheria-input formula-input"}}
            </div>

            <div class="flexcol">
              <input type="text" name="{{concat cost.name ".resource"}}" value="{{cost.value.resource}}"
                class="etheria-input key-input" placeholder="Resource" list="{{@root.rootId}}-cost-resource">
            </div>

            <div class="controls">
              <a data-action="deleteCost" data-id="{{id}}" class="fa-solid fa-trash clickable-anchor"
                data-tooltip="Remove"></a>
            </div>
          </div>
          {{/each}}
          <datalist id="{{rootId}}-cost-resource">
            {{#each resourcesChoices as |label value|}}
            <option value="{{value}}">{{label}}</option>
            {{/each}}
          </datalist>
        </div>
      </div>
    </section>

    <section class="glass-panel stat-list spheres-list">
      <div class="panel-header flexrow">
        <span class="label">Magic Spheres</span>
      </div>
      {{formInput systemFields.spheres type="checkboxes" value=system.spheres classes="etheria-checkboxes"}}
    </section>

    <div class="glass-panel stat-list ability-list">
      <div class="panel-header flexrow">
        <span class="label">Ability Damages</span>
        <div class="controls">
          <a data-action="createDamage" class="fa-solid fa-plus clickable-anchor" data-tooltip="Add Damage"></a>
        </div>
      </div>

      <div class="element-items flexcol">
        {{#each system.damages as |damage id|}}
        <div class="stat-row" data-damage-id="{{id}}">

          <div class="flexcol">
            {{formInput damage.schema.fields.formula name=(concat "system.damages." id ".formula") placeholder="Damage
            Formula"
            value=damage.formula classes="etheria-input formula-input" disabled=(eq damage.type "equippedItem")
            dataset=(object tooltip=(ifThen (eq damage.type "equippedItem") "You cannot set a formula when using
            equipper item damage." "")) }}
          </div>

          <div class="flexcol">
            {{formInput damage.schema.fields.type name=(concat "system.damages." id ".type") value=damage.type
            classes="etheria-input type-input"}}
          </div>

          <div class="controls">
            <a data-action="deleteDamage" data-id="{{id}}" class="fa-solid fa-trash clickable-anchor"
              data-tooltip="Remove"></a>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>