<section class="accordion-wrapper {{ifThen expanded 'expanded' ''}}">
  <div class="accordion-toggle" data-action="toggleAccordion">
    <i class="toggle-icon fa-solid fa-chevron-right"></i>
    <span>Action Panels</span>
  </div>

  <div class="accordion-content">
    <div class="ui-frame-list invisible-scrollbar">
      {{#each characters as |actor|}}
      {{> "modules/etheria-uts/templates/actions-panel/character-panel.hbs" actor=actor}}
      {{/each}}
    </div>
  </div>
</section>