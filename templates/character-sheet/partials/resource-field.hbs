<div class="resource-field flexcol glass-panel {{classes}}">
  <div class="resource-header flexrow">
    <label class="resource-label">
      {{ifThen label label data.label}}
    </label>
  </div>

  <div class="resource-inputs flexrow">
    {{#if isArmor}}
    <input class="etheria-input" type="number" name="{{path}}.value" value="{{data.value}}" step="1" {{disabled
      disabled}}>
    {{else}}
    <input class="etheria-input" type="number" name="{{path}}.value" value="{{data.value}}" step="1">
    {{/if}}
    {{#if (ne data.max null)}}
    <input class="etheria-input" type="number" name="{{path}}.max" value="{{data.max}}" step="1" {{disabled disabled}}>
    {{/if}}
  </div>

</div>