<section class="tab{{#if tab.active}} active{{/if}} scrollable" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="tab-container flexcol">

    <section class="race-section glass-panel" data-doc-uuid="{{system.race.uuid}}">
      {{#if system.race}}
      <div class="race-content draggable" data-item-id="{{system.race.id}}" data-action="viewDoc"
        data-tooltip="Click to Edit Race">
        <div class="item-portrait race-portrait">
          <img src="{{system.race.img}}" alt="{{system.race.name}}">
        </div>
        <label class="race-label">{{system.race.name}}</label>
        <div class="controls">
          <a class="item-control" data-action="deleteDoc" data-tooltip="{{localize 'DOCUMENT.Delete' type='Race'}}">
            <i class="fa-solid fa-trash"></i>
          </a>
        </div>
      </div>
      {{else}}
      <div class="race-content" data-action="createRace" data-tooltip="Click to Create a New Race">
        <div class="item-portrait race-portrait">
          <i class="fa-solid fa-circle-plus"></i>
        </div>
        <label class="race-label">Create Race</label>
      </div>
      {{/if}}
    </section>

    <section class="exhaustion-section glass-panel">
      {{formInput exhaustion.field value=exhaustion.value classes="etheria-input" dataset=(object tooltip="Exhaustion
      Value") disabled=isPlayMode}}
      <label class="exhaustion-label">Exhaustion</label>
      <div class="exhaustion-mod" data-tooltip="Exhaustion Modifier">({{numberFormat exhaustion.mod sign=true}})</div>
    </section>

    <section class="defense-stats-section">
      <div class="defense-box stat-box flex-center glass-panel" data-tooltip="Block Bonus">
        <i class="fa-solid fa-shield-halved"></i>
        <div class="defense-value">{{numberFormat system.defense.block.value sign=true}}</div>
      </div>

      <div class="defense-box stat-box flex-center glass-panel" data-tooltip="Parry Bonus">
        <i class="fa-solid fa-swords"></i>
        <div class="defense-value">{{numberFormat system.defense.parry.value sign=true}}</div>
      </div>

      <div class="defense-box stat-box flex-center glass-panel" data-tooltip="Dodge Bonus">
        <i class="fa-solid fa-person-running"></i>
        <div class="defense-value">{{numberFormat system.defense.dodge.value sign=true}}</div>
      </div>
    </section>

    <section class="glass-panel attributes-list stat-list flexcol">
      {{#each attributes}}
      <div class="stat-row">
        <div class="stat-label">{{localize field.label}}</div>
        <div data-tooltip="{{field.label}} Value">{{formInput field value=value classes="etheria-input"
          disabled=@root.isPlayMode}}</div>
        <div class="mod-value" data-tooltip="{{field.label}} Modifier">
          {{numberFormat mod sign=true}}
        </div>
        <div>
          <button type="button" class="etheria-button" data-tooltip="Roll {{field.label}}" data-action="rollAttribute"
            data-attribute="{{@key}}">
            <i class="fa-solid fa-dice-d20"></i> Roll
          </button>
        </div>
      </div>
      {{/each}}
    </section>

    <section class="recovery-section">
      <button class="recover-btn flex-center etheria-button" type="button" data-tooltip="Recover Stamina"
        data-action="recoverResource" data-resource="stamina">
        <i class="fa-solid fa-heart-circle-bolt"></i>
        <span>
          {{numberFormat actor.system.recovers.stamina.value sign=true}}
        </span>
      </button>
      {{#if system.details.isCaster}}
      <button class="recover-btn flex-center etheria-button" type="button" data-tooltip="Recover Mana" data-action="recoverResource"
        data-resource="mana">
        <i class="fa-solid fa-fire-flame"></i>
        <span>
          {{numberFormat actor.system.recovers.mana.value sign=true}}
        </span>
      </button>
      {{/if}}
    </section>

    <section class="dice-resources-section">
      <div class="roll-box stat-box flex-center glass-panel">
        <a class="clickable-anchor icon-layer" data-tooltip="Roll Health Advancement" data-action="rollAdvancement"
          data-type="health">
          <i class="fa-solid fa-heart"></i>
          <i class="sub-icon fa-duotone fa-light fa-dice-d20"></i>
        </a>
        {{formInput systemFields.advancementRoll.fields.health value=(ifThen isPlayMode system.advancementRoll.health
        source.system.advancementRoll.health)
        classes="etheria-input" disabled=isPlayMode}}
      </div>

      <div class="roll-box stat-box flex-center glass-panel">
        <a class="clickable-anchor icon-layer" data-tooltip="Roll Resource Advancement" data-action="rollAdvancement"
          data-type="resource">
          <i class="fa-solid fa-sparkles"></i>
          <i class="sub-icon fa-duotone fa-light fa-dice-d20"></i>
        </a>
        {{formInput systemFields.advancementRoll.fields.resource value=(ifThen isPlayMode system.advancementRoll.resource
        source.system.advancementRoll.resource)
        classes="etheria-input" disabled=isPlayMode}}
      </div>
    </section>
  </div>
</section>