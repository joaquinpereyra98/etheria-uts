<section class="tab {{#if tab.active}}active{{/if}} scrollable" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="tab-container flexcol">

    {{#each abilities as |category key|}}
    <div class="ability-category" data-category="{{key}}">
      <div class="category-title glass-panel">
        <div class="label">{{category.label}}</div>
        <div class="controls">
          {{#if @root.user.isGM}}
          <a class="icon fa-solid fa-plus" data-action="createAbility"></a>
          {{/if}}
        </div>
      </div>

      <div class="abilities-items">
        {{#each category.items as |item i|}}
        <div class="ability-card glass-panel draggable" data-item-id="{{item.id}}" data-doc-uuid="{{item.uuid}}">
          {{#if item.system.uses.max}}
          <div class="uses-badge">
            {{item.system.uses.value}} / {{item.system.uses.max}}
          </div>
          {{/if}}
          <div class="card-content">

            <div class="portait">
              <img class="portait-img" src="{{item.img}}" alt="{{item.name}}" loading="lazy" data-action="viewDoc" />
            </div>

            <div class="details-container">
              <div class="ability-name" data-tooltip="{{item.name}}">{{item.name}}</div>

              <div class="details-row">
                {{#if item.system.range}}
                <b>Range:</b> <span>{{item.system.enritcherRange}}</span>
                {{/if}}
              </div>
              <div class="details-row">
                {{#if item.system.area}}
                <b>Area:</b><span>{{item.system.area}}</span>
                {{/if}}
              </div>
              {{#if (and item.system.cost.value item.system.cost.resource)}}
              <div class="details-row">
                <b>Cost:</b><span>{{item.system.cost.value}} {{lookup @root.resourcesChoices
                  item.system.cost.resource}}</span>
              </div>
              {{/if}}
              {{#each item.system.damages}}
              {{#if (and formula type)}}
              <div class="details-row">
                <b>Damage:</b><span>{{formula}} {{lookup @root.damageTypeChoices type}}</span>
              </div>
              {{/if}}
              {{/each}}
            </div>

            <div class="controls">
              <a class="item-control" data-action="viewDoc"
                data-tooltip="{{localize 'DOCUMENT.Update' type='Ability'}}">
                <i class="fa-solid fa-edit"></i>
              </a>
              {{#if @root.user.isGM}}
              <a class="item-control" data-action="deleteDoc"
                data-tooltip="{{localize 'DOCUMENT.Delete' type='Ability'}}">
                <i class="fa-solid fa-trash"></i>
              </a>
              {{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>

      {{!-- Section separator --}}
      {{#unless @last}}
      <hr class="etheria-hr">
      {{/unless}}

    </div>
    {{/each}}

  </div>
</section>