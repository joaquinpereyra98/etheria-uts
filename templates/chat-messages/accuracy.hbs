<div class="accuracy-message">
  {{#if document.flavor}}
  <span class="flavor">{{{document.flavor}}}</span>
  {{/if}}

  <section class="targets accordion flexcol">
    <header class="targets-header flexrow accordion-header {{ifThen accordionState 'expanded' '' }}"
      data-action="toggleAccordion">
      <i class="accordion-chevron icon fa-solid fa-chevron-right"></i>

      <div class="title-container">
        <span class="title">Targets</span>
        <span class="number">({{targets.size}})</span>
      </div>

      {{#if isOwner}}
      <a class="refresh-anchor" data-action="refreshTargets" data-tooltip="Update Targets from selection">
        <i class="icon fa-solid fa-arrows-rotate"></i>
      </a>
      {{/if}}
    </header>

    <div class="target-list accordion-content">
      <div class="wrappler">
        {{#each targets}}
        <div class="target-item flexrow" data-uuid="{{uuid}}">
          <img src="{{doc.texture.src}}">
          <span class="item-label">{{doc.name}}</span>
          <div class="target-controls">
            {{#if ../acc.isEvaluated}}
            <a class="fa-solid fa-shield-halved" data-tooltip="Roll Block ({{doc.actor.system.defense.block.value}})" data-action="rollDefense" data-type="block"></a>
            <a class="fa-solid fa-swords" data-tooltip="Roll Parry ({{doc.actor.system.defense.parry.value}})" data-action="rollDefense" data-type="parry"></a>
            <a class="fa-solid fa-person-running" data-tooltip="Roll Dodge ({{doc.actor.system.defense.dodge.value}})" data-action="rollDefense" data-type="dodge"></a>
            {{/if}}
             {{#if ../damages.isEvaluated}}
            <div class="vertical"></div>
            <a class="fa-solid fa-burst" data-tooltip="Apply Damage" data-action="applyDamage"></a>
            {{/if}}
          </div>
          {{#unless ../isIdle}}
          {{/unless}}
        </div>
        {{/each}}
      </div>
    </div>
    <hr class="etheria-hr">
  </section>

  {{#if renderedRolls.length}}
  <section class="base-rolls">
    {{#each renderedRolls}}{{{this}}}{{/each}}
    <hr class="etheria-hr">
  </section>
  {{/if}}

  <div class="item-actions flexcol">
    {{#if isOwner}}
    <div class="action-row">
      <button class="item-action etheria-button" data-type="accuracy" data-action="promptGMForRoll" {{disabled (not acc.isIdle)}}>
        <div class="img-portrait">
          <i class="icon fa-solid {{acc.icon}}"></i>
        </div>
        <span class="action-label">{{acc.buttonLabel}}</span>
      </button>
      {{#if (and isGM acc.isEvaluated)}}
      <a class="action-anchor icon fa-solid fa-arrow-rotate-right" data-tooltip="Re-Evaluate Roll"
        data-action="reEvaluateRoll" data-type="accuracy"></a>
      {{/if}}
    </div>
     <div class="action-row">
      <button class="item-action etheria-button" data-type="damages" data-action="promptGMForRoll" {{disabled (not damages.isIdle)}}>
        <div class="img-portrait">
          <i class="icon fa-solid {{damages.icon}}"></i>
        </div>
        <span class="action-label">{{damages.buttonLabel}}</span>
      </button>
      {{#if (and isGM damages.isEvaluated)}}
      <a class="action-anchor icon fa-solid fa-arrow-rotate-right" data-tooltip="Re-Evaluate Roll"
        data-action="reEvaluateRoll" data-type="damages"></a>
      {{/if}}
    </div>
    {{/if}}
  </div>
</div>